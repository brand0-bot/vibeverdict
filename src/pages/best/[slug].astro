---
import Base from '../../layouts/Base.astro';
import ToolOffer from '../../components/ToolOffer.astro';
import { bySlug } from '../../lib/data.js';
import { roundups, guidesForTools } from '../../lib/guides.js';

export function getStaticPaths() {
  return roundups.map(page => ({
    params: { slug: page.slug },
    props: { page, picks: page.tools.map(pick => ({ ...pick, tool: bySlug[pick.slug] })) }
  }));
}

const { page, picks } = Astro.props;
const pageUrl = `https://vibeverdict.ai/best/${page.slug}/`;
const related = guidesForTools(page.tools.map(pick => pick.slug), bySlug, pageUrl);
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: page.title,
    description: page.description,
    url: pageUrl,
    mainEntity: {
      '@type': 'ItemList',
      itemListOrder: 'https://schema.org/ItemListOrderAscending',
      numberOfItems: picks.length,
      itemListElement: picks.map((pick, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: pick.tool.name,
        url: `https://vibeverdict.ai/tools/${pick.tool.slug}/`
      }))
    }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [{
      '@type': 'Question',
      name: page.title,
      acceptedAnswer: { '@type': 'Answer', text: page.verdict }
    }]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://vibeverdict.ai/' },
      { '@type': 'ListItem', position: 2, name: 'Best', item: 'https://vibeverdict.ai/best/' },
      { '@type': 'ListItem', position: 3, name: page.title, item: pageUrl }
    ]
  }
];
---
<Base title={`${page.title} (2026)`} description={page.description} schema={schema}>
<p class="mut" style="margin-top:24px"><a href="/">Home</a> / <a href="/best/">Best</a></p>
<h1>{page.title}</h1>
<div class="card" style="font-size:19px"><b>{page.verdict}</b></div>
<div class="grid" style="margin-top:18px">{picks.map((pick, i) => <ToolOffer t={pick.tool} why={`${i + 1}. ${pick.why}`} />)}</div>
{related.length > 0 && <><h2>Comparisons</h2><ul>{related.map(r => <li><a href={r.href}>{r.title}</a></li>)}</ul></>}
</Base>
