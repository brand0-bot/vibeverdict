---
import Base from '../layouts/Base.astro'; import NewsletterForm from '../components/NewsletterForm.astro'; import NewsList from '../components/NewsList.astro'; import XHighlights from '../components/XHighlights.astro'; import { tools, categories, label, bySlug } from '../lib/data.js';
import { comparisons, comparisonTitle, roundups } from '../lib/guides.js';
const schema={"@context":"https://schema.org","@type":"WebSite",name:"VibeVerdict",url:"https://vibeverdict.ai"};
---
<Base title="VibeVerdict: Is this AI tool worth it?" description="Pricing, one-line verdicts, pros/cons and alternatives for AI, agent and vibe-coding tools, always dated and verified." schema={schema}>
<section class="hero" style="padding:56px 0 28px"><h1>Is this AI tool <span style="color:var(--acc)">worth it?</span></h1>
<p class="mut" style="font-size:19px;max-width:640px">One-line verdicts, real pricing with sources, and better alternatives for {tools.length} AI, agent and vibe-coding tools. Every price shows the date it was last verified.</p>
<NewsletterForm /></section>
<NewsList limit={5} heading="Trending in AI" more="/news/" />
<XHighlights limit={3} />
<section><h2>Comparisons and roundups</h2><div class="grid">
{roundups.map(page => <a class="card" href={`/best/${page.slug}/`}><b>{page.title}</b><p class="mut" style="font-size:14px;margin:8px 0 0">{page.verdict}</p></a>)}
{comparisons.map(page => <a class="card" href={`/compare/${page.slug}/`}><b>{comparisonTitle(page, bySlug)}</b><p class="mut" style="font-size:14px;margin:8px 0 0">{page.description || 'Side-by-side verdicts. Prices appear only when verified on the vendor site.'}</p></a>)}
</div><p><a href="/compare/">All comparisons</a> · <a href="/best/">All roundups</a></p></section>
{Object.entries(categories).map(([k,v])=>(<section><h2>{v}</h2><p class="mut"><a href={`/category/${k}/`}>See all {v}</a></p><div class="grid">
{tools.filter(t=>t.category===k).map(t=>(<a class="card" href={`/tools/${t.slug}/`} style="color:inherit;text-decoration:none"><div style="display:flex;justify-content:space-between"><b>{t.name}</b><span class={`pill ${t.rating}`}>{label[t.rating]}</span></div><p class="mut" style="font-size:14px;margin:8px 0 0">{t.verdict}</p><div style="font-size:12px;margin-top:8px" class="mut">{t.verified?`✓ Verified ${t.lastVerified}`:'⚠ Pricing unverified'}</div></a>))}</div></section>))}
</Base>
