{
  "name": "vibeverdict",
  // Current date. Workers uses this to select compatibility behavior.
  "compatibility_date": "2026-10-14",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "triggers": {
    "crons": ["*/30 * * * *"]
  }
}
